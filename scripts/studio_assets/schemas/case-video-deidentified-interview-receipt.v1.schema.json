{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/case-video-deidentified-interview-receipt.v1.schema.json",
  "title": "Deidentified interview quote receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "slot_id",
    "script_id",
    "content_id",
    "synthetic_only",
    "quote_text",
    "quote_sha256",
    "recording_artifact_ref",
    "consent_artifact_ref",
    "consent",
    "privacy",
    "rights",
    "human_verification",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "case-video-deidentified-interview-receipt.v1" },
    "receipt_id": { "type": "string", "pattern": "^interview-receipt-[a-z0-9][a-z0-9-]{7,63}$" },
    "slot_id": { "type": "string", "pattern": "^interview-[0-9]{2}$" },
    "script_id": { "type": "string", "pattern": "^case-script-[a-z0-9][a-z0-9-]{7,63}$" },
    "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$" },
    "synthetic_only": { "type": "boolean" },
    "quote_text": { "type": "string", "minLength": 1, "maxLength": 600 },
    "quote_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recording_artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "consent_artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "scope_sha256"],
      "properties": {
        "status": { "const": "granted" },
        "scope": { "const": "deidentified-case-video-quote" },
        "scope_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "direct_identifiers_removed", "reidentification_risk"],
      "properties": {
        "status": { "const": "pass" },
        "direct_identifiers_removed": { "const": true },
        "reidentification_risk": { "const": "low" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allowed_use"],
      "properties": {
        "status": { "const": "pass" },
        "allowed_use": { "const": "candidate-video-script" }
      }
    },
    "human_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": { "const": "pass" },
        "reviewer": { "type": "string", "pattern": "^(synthetic-fixture-reviewer|local-reviewer-[a-z0-9-]{4,48})$" },
        "reviewed_at": { "type": "string", "format": "date-time" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_only", "raw_media_embedded", "absolute_path_included", "external_service_called", "would_publish"],
      "properties": {
        "local_only": { "const": true },
        "raw_media_embedded": { "const": false },
        "absolute_path_included": { "const": false },
        "external_service_called": { "const": false },
        "would_publish": { "const": false }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$" },
        "schema_version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
