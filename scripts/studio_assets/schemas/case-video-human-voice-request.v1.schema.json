{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/case-video-human-voice-request.v1.schema.json",
  "title": "Case video human voice rewrite request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "script_id",
    "content_id",
    "synthetic_only",
    "initial_draft_review_ref",
    "rewrite_operations",
    "dbs_content_diagnosis",
    "dbs_ai_check_diagnosis",
    "read_aloud",
    "author_confirmation",
    "post_freeze_hooks",
    "post_freeze_selected_hook_id",
    "hook_input_body_sha256",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "case-video-human-voice-request.v1" },
    "request_id": { "type": "string", "pattern": "^voice-request-[a-z0-9][a-z0-9-]{7,63}$" },
    "script_id": { "type": "string", "pattern": "^case-script-[a-z0-9][a-z0-9-]{7,63}$" },
    "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$" },
    "synthetic_only": { "type": "boolean" },
    "editing_mode": { "enum": ["rewrite", "review_without_rewrite"] },
    "semantic_review": { "$ref": "#/$defs/semanticReview" },
    "initial_draft_review_ref": { "$ref": "#/$defs/artifactRef" },
    "rewrite_operations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "before_text_sha256", "replacement_text", "reason"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^segment-[0-9]{2}$" },
          "before_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "replacement_text": { "type": "string", "minLength": 1, "maxLength": 1600 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "dbs_content_diagnosis": { "$ref": "#/$defs/diagnosis" },
    "dbs_ai_check_diagnosis": { "$ref": "#/$defs/diagnosis" },
    "read_aloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "performed_by", "body_sha256", "completed_at", "notes"],
      "properties": {
        "status": { "const": "completed" },
        "performed_by": { "enum": ["author", "synthetic-fixture-author"] },
        "body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "completed_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "author_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "performed_by", "body_sha256", "confirmed_at", "voice_match", "facts_preserved"],
      "properties": {
        "status": { "const": "confirmed" },
        "performed_by": { "enum": ["author", "synthetic-fixture-author"] },
        "body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "voice_match": { "const": true },
        "facts_preserved": { "const": true }
      }
    },
    "post_freeze_hooks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hookCandidate" }
    },
    "post_freeze_selected_hook_id": { "type": "string", "pattern": "^hook-[0-9]{2}$" },
    "hook_input_body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_only", "external_service_called", "raw_sensitive_media_included", "would_publish"],
      "properties": {
        "local_only": { "const": true },
        "external_service_called": { "const": false },
        "raw_sensitive_media_included": { "const": false },
        "would_publish": { "const": false }
      }
    }
  },
  "$defs": {
    "semanticReview": {
      "type": "object", "additionalProperties": false,
      "required": ["input_body_sha256", "output_body_sha256", "reviewer_kind", "voice_basis", "checks"],
      "properties": {
        "story_realization": {"type": "object", "description": "Sentence-bound narrative review of the rewritten story, not the previous draft."},
        "input_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewer_kind": {"enum": ["agent_editor", "human_editor", "synthetic_fixture"]},
        "voice_basis": {"$ref": "#/$defs/artifactRef"},
        "checks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["check_id", "segment_id", "before_span", "after_span", "status", "reason"],
          "properties": {
            "check_id": {"enum": ["production_note_leak", "conversation_correction_leak", "information_progression", "author_voice_fit", "fact_boundary"]},
            "segment_id": {"type": "string", "pattern": "^segment-[0-9]{2}$"},
            "before_span": {"type": "string", "minLength": 4, "maxLength": 800},
            "after_span": {"type": "string", "minLength": 4, "maxLength": 800},
            "status": {"enum": ["clear", "resolved", "blocked"]},
            "reason": {"type": "string", "minLength": 12, "maxLength": 800}
          }
        }}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issue_codes", "note"],
      "properties": {
        "status": { "enum": ["passed_to_local_rewrite", "reviewed_no_lexical_match", "semantic_review_required"] },
        "issue_codes": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "enum": [
              "symmetric-slogan",
              "uniform-cta",
              "over-explained",
              "even-rhythm",
              "translation-register",
              "abstract-service-language",
              "ai-trace"
            ]
          }
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id"],
      "properties": {
        "ref_type": { "enum": ["claim", "evidence", "source", "contradiction", "unknown"] },
        "ref_id": { "type": "string", "minLength": 1 }
      }
    },
    "hookCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_id", "text", "evidence_refs", "status", "risk_status"],
      "properties": {
        "hook_id": { "type": "string", "pattern": "^hook-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } },
        "status": { "const": "candidate" },
        "risk_status": { "const": "pass" }
      }
    }
  }
}
