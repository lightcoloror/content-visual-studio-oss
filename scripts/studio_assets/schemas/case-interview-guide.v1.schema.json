{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-recording interview questions, never an interview transcript",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "guide_id", "synthetic_only", "mode", "purpose", "audience", "fact_card_ref", "questions", "unknowns", "production_notes", "review_status", "publication_boundary"],
  "properties": {
    "schema_version": {"const": "case-interview-guide.v1"},
    "guide_id": {"type": "string", "pattern": "^interview-guide-[a-z0-9-]+$"},
    "synthetic_only": {"type": "boolean"},
    "mode": {"const": "draft_only"},
    "purpose": {"type": "string", "minLength": 8},
    "audience": {"type": "string", "minLength": 4},
    "fact_card_ref": {"type": "object", "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "sha256"], "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }},
    "questions": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "question", "purpose", "follow_ups", "premise_fact_ids"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q-[0-9]{2}$"},
        "question": {"type": "string", "minLength": 4},
        "purpose": {"type": "string", "minLength": 8},
        "follow_ups": {"type": "array", "items": {"type": "string", "minLength": 4}},
        "premise_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
    "production_notes": {"type": "array", "items": {"type": "string"}},
    "review_status": {"const": "required"},
    "publication_boundary": {"const": "manual-only"}
  }
}
