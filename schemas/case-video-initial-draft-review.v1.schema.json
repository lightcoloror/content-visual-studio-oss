{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/case-video-initial-draft-review.v1.schema.json",
  "title": "Case video initial draft quality review",
  "description": "Storycraft 初稿进入内容诊断、口吻改写和 Hook 之前的人工审核回执。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "script_id",
    "content_id",
    "synthetic_only",
    "stage",
    "content_goal",
    "input_body_sha256",
    "input_fact_card_ref",
    "gates",
    "review_mode",
    "reviewer",
    "reviewed_at",
    "decision",
    "publication_boundary"
  ],
  "properties": {
    "schema_version": { "const": "case-video-initial-draft-review.v1" },
    "review_id": { "type": "string", "pattern": "^initial-draft-review-[a-z0-9][a-z0-9-]{5,63}$" },
    "script_id": { "type": "string", "pattern": "^case-script-[a-z0-9][a-z0-9-]{7,63}$" },
    "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$" },
    "synthetic_only": { "type": "boolean" },
    "stage": { "const": "post-storycraft-pre-voice" },
    "content_goal": {
      "enum": ["acquisition", "consultation", "conversion", "education", "trust", "relationship", "documentation"]
    },
    "input_body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_fact_card_ref": { "$ref": "#/$defs/artifactRef" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_evidence",
        "single_task",
        "service_causality",
        "interview_integrity",
        "distribution_compliance",
        "medical_insurance",
        "privacy_authorization",
        "title_opening_alignment",
        "voice_ai_trace",
        "cta_product",
        "production_series"
      ],
      "properties": {
        "fact_evidence": { "$ref": "#/$defs/gateDecision" },
        "single_task": { "$ref": "#/$defs/gateDecision" },
        "service_causality": { "$ref": "#/$defs/gateDecision" },
        "interview_integrity": { "$ref": "#/$defs/gateDecision" },
        "distribution_compliance": { "$ref": "#/$defs/gateDecision" },
        "medical_insurance": { "$ref": "#/$defs/gateDecision" },
        "privacy_authorization": { "$ref": "#/$defs/gateDecision" },
        "title_opening_alignment": { "$ref": "#/$defs/gateDecision" },
        "voice_ai_trace": { "$ref": "#/$defs/gateDecision" },
        "cta_product": { "$ref": "#/$defs/gateDecision" },
        "production_series": { "$ref": "#/$defs/gateDecision" }
      }
    },
    "review_mode": { "enum": ["synthetic-fixture-review", "human-local-editorial-review"] },
    "reviewer": { "type": "string", "pattern": "^(synthetic-fixture-reviewer|local-editor-[a-z0-9-]{4,48})$" },
    "reviewer_artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "story_realization": {"type": "object", "description": "Current story card and sentence-bound editorial review, validated by narrative_realization.py."},
    "reviewed_at": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["approved_for_voice_pipeline", "return_for_revision", "blocked_from_downstream"] },
    "publication_boundary": { "const": "manual-only" }
  },
  "allOf": [
    {
      "if": { "properties": { "synthetic_only": { "const": true } }, "required": ["synthetic_only"] },
      "then": {
        "properties": {
          "review_mode": { "const": "synthetic-fixture-review" },
          "reviewer": { "const": "synthetic-fixture-reviewer" }
        }
      },
      "else": {
        "required": ["reviewer_artifact_ref"],
        "properties": {
          "review_mode": { "const": "human-local-editorial-review" },
          "reviewer": { "pattern": "^local-editor-[a-z0-9-]{4,48}$" }
        }
      }
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_check_ids", "findings", "remediation", "evidence"],
      "properties": {
        "status": { "enum": ["pass", "needs_revision", "blocked", "not_applicable"] },
        "reviewed_check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" }
        },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "remediation": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  }
}
